---
import type { PageContent } from "../../content/page";
import Container from "@autonoma/ui/components/Container.astro";
import Section from "@autonoma/ui/components/Section.astro";

interface Props {
  virtual: PageContent["virtual"];
}

const { virtual } = Astro.props as Props;
---

<Section id="virtual" tone="mint" ariaLabelledby="virtual-title" class="!py-0 lg:!pt-[var(--space-section-y)] lg:!pb-0">
  <Container class="relative">
    <div
      class="grid items-center gap-8 py-12 pb-0 sm:py-16 sm:pb-0 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,0.85fr)_minmax(0,1fr)] lg:items-stretch lg:gap-4 lg:py-0 xl:gap-6"
    >
      {/* Mobile Figma: título + QS primero; desktop: panel bocadillo. */}
      <div
        class="relative isolate flex flex-col text-brand lg:min-h-[30.5rem] lg:self-center lg:text-white"
      >
        <img
          src="/assets/figma/arequipa/virtual/orange-blob.svg"
          alt=""
          width="752"
          height="488"
          class="pointer-events-none absolute inset-y-[6%] left-[-12%] z-0 hidden h-[88%] w-[124%] max-w-none select-none object-fill lg:block lg:left-[-18%] lg:w-[132%]"
          aria-hidden="true"
        />

        <div class="relative z-10 flex flex-1 flex-col items-center gap-6 px-2 text-center sm:px-4 lg:max-w-[22rem] lg:items-center lg:justify-center lg:gap-8 lg:px-2 lg:py-14 xl:max-w-[24rem]">
          <h2
            id="virtual-title"
            class="reveal-lines text-[clamp(1.75rem,2.4vw+0.5rem,2.625rem)] leading-[1.05]"
            data-reveal-lines
          >
            <span class="reveal-line-mask block">
              <span class="reveal-line block font-light" style="--line-delay: 0ms">{virtual.title}</span>
            </span>
            <span class="reveal-line-mask block">
              <span class="reveal-line block font-bold" style="--line-delay: 90ms">
                {virtual.titleAccent}
                {virtual.titleTail ? ` ${virtual.titleTail}` : ""}
                <span class="ml-1 inline-flex items-center gap-0.5 align-middle" aria-hidden="true">
                  <img
                    src="/assets/figma/arequipa/virtual/brace-white.svg"
                    alt=""
                    width="18"
                    height="31"
                    class="hidden h-[0.75em] w-auto lg:inline"
                  />
                  <img
                    src="/assets/figma/arequipa/virtual/brace-white.svg"
                    alt=""
                    width="18"
                    height="31"
                    class="hidden h-[0.75em] w-auto lg:inline"
                  />
                </span>
              </span>
            </span>
          </h2>

          <div data-reveal>
            <p class="text-[1rem] font-normal leading-normal text-negro lg:text-white">{virtual.partnerLabel}</p>
            <img
              src={virtual.partnerLogoSrc}
              alt="QS World University Rankings"
              class="mx-auto mt-2 h-12 w-auto"
              width="179"
              height="48"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      {/* Center: cutout — en mobile va después del accordion */}
      <div class="relative z-[1] order-last flex justify-center lg:order-none lg:self-end" data-reveal>
        <img
          src={virtual.imageSrc}
          alt="Egresado de la Autónoma trabajando con una tablet"
          class="w-full max-w-[16.25rem] object-contain drop-shadow-[0_18px_40px_rgba(18,18,18,0.18)] sm:max-w-[20rem] lg:max-w-none"
          width="434"
          height="652"
          loading="lazy"
          data-parallax
          data-parallax-speed="0.06"
          data-parallax-max="28"
        />
      </div>

      {/* Right: benefits accordion */}
      <div class="order-2 self-center lg:order-none lg:self-center" data-accordion="virtual">
        {
          virtual.items.map((item, index) => {
            const open = index === 0;
            return (
              <div class="border-b-2 border-brand/35" data-accordion-item>
                <h3>
                  <button
                    type="button"
                    class:list={[
                      "virtual-acc-trigger flex w-full items-center justify-between gap-4 py-2.5 text-left text-[1.25rem] leading-snug text-brand transition-[font-weight] duration-[var(--duration-faq)] ease-[var(--ease-out)]",
                      open ? "font-bold" : "font-normal",
                    ]}
                    aria-expanded={open ? "true" : "false"}
                    data-accordion-trigger
                  >
                    <span>{item.title}</span>
                    <span
                      class="relative inline-flex size-4 shrink-0 items-center justify-center text-[1.35rem] font-light leading-none"
                      aria-hidden="true"
                    >
                      <span data-accordion-icon-plus>+</span>
                      <span data-accordion-icon-minus>−</span>
                    </span>
                  </button>
                </h3>
                <div
                  class="virtual-acc-panel"
                  data-accordion-panel
                  data-open={open ? "true" : "false"}
                  hidden={!open}
                >
                  <div class="virtual-acc-panel-inner">
                    <p class="pb-4 text-[1rem] font-normal leading-normal text-negro">{item.body}</p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </Container>
</Section>

<script>
  document.querySelectorAll('[data-accordion="virtual"]').forEach((root) => {
    const prefersReduced =
      typeof window.matchMedia === "function" &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const durationMs = (() => {
      const raw = getComputedStyle(document.documentElement).getPropertyValue("--duration-faq").trim();
      if (raw.endsWith("ms")) return Number.parseFloat(raw) || 320;
      if (raw.endsWith("s")) return (Number.parseFloat(raw) || 0.32) * 1000;
      return 320;
    })();

    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-accordion-item]"));
    const timers = new WeakMap<HTMLElement, number>();

    const setOpen = (item: HTMLElement, open: boolean) => {
      const trigger = item.querySelector<HTMLButtonElement>("[data-accordion-trigger]");
      const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
      if (!trigger || !panel) return;

      const prev = timers.get(panel);
      if (prev) window.clearTimeout(prev);

      trigger.setAttribute("aria-expanded", String(open));
      trigger.classList.toggle("font-bold", open);
      trigger.classList.toggle("font-normal", !open);

      if (open) {
        panel.hidden = false;
        void panel.offsetHeight;
        panel.dataset.open = "true";
        panel.removeAttribute("data-animating");
        return;
      }

      panel.dataset.open = "false";
      panel.setAttribute("data-animating", "");

      if (prefersReduced) {
        panel.hidden = true;
        panel.removeAttribute("data-animating");
        return;
      }

      const id = window.setTimeout(() => {
        if (panel.dataset.open === "false") {
          panel.hidden = true;
          panel.removeAttribute("data-animating");
        }
      }, durationMs);
      timers.set(panel, id);
    };

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>("[data-accordion-trigger]");
      if (!trigger) return;

      trigger.addEventListener("click", () => {
        const willOpen = trigger.getAttribute("aria-expanded") !== "true";
        items.forEach((other) => setOpen(other, willOpen && other === item));
      });
    });
  });
</script>
