---
import type { PageContent } from "../../content/page";
import Container from "@autonoma/ui/components/Container.astro";
import Section from "@autonoma/ui/components/Section.astro";

interface Props {
  aliados: PageContent["aliados"];
}

const { aliados } = Astro.props as Props;
---

<Section id="aliados" tone="white" ariaLabelledby="aliados-title">
  <Container>
    <div class="max-w-3xl text-left lg:mx-auto lg:text-center" data-reveal>
      <h2 id="aliados-title" class="text-section-title-aq font-bold">{aliados.title}</h2>
      <p class="mt-4 hidden text-small text-text-muted lg:block">{aliados.subtitle}</p>
    </div>

    <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3 lg:mt-10" data-reveal-stagger>
      {
        aliados.items.map((ally) => (
          <li
            class="flex min-h-[114px] flex-col items-center justify-center gap-2 rounded-2xl border border-border bg-surface px-4 py-5 text-center sm:min-h-[164px] sm:gap-3 sm:py-6"
            data-reveal-item
          >
            <img
              src={ally.logoSrc}
              alt=""
              class="h-16 w-auto max-w-[180px] object-contain sm:h-20"
              width="180"
              height="80"
              loading="lazy"
              onerror="this.style.display='none'"
            />
            <span class="text-small font-semibold text-text-muted">{ally.name}</span>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
