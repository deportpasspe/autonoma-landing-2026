---
import type { PageContent } from "../../content/page";
import Container from "@autonoma/ui/components/Container.astro";
import Section from "@autonoma/ui/components/Section.astro";

interface Props {
  contacto: PageContent["contacto"];
}

const { contacto } = Astro.props as Props;
---

<Section id="contacto" tone="white" ariaLabelledby="contacto-title">
  <Container>
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,753fr)_minmax(0,500fr)]">
      <div class="contacto-map relative aspect-[753/488] w-full overflow-hidden" data-reveal>
        <iframe
          title="Mapa de la oficina Autónoma Virtual en Av. Ejército 1059B, Cayma, Arequipa"
          src={contacto.mapEmbedSrc}
          class="absolute inset-0 h-full w-full border-0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        >
        </iframe>
      </div>

      <div data-reveal class="text-center lg:text-left">
        <h2 id="contacto-title" class="text-section-title-aq font-bold">{contacto.title}</h2>
        <p class="mt-3 text-body text-negro">{contacto.address}</p>

        <div class="mt-8 space-y-6">
          <div class="flex items-start justify-center gap-4 lg:justify-start">
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center text-brand" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <path
                  d="M4 5h3l1.6 4.2-2 1.4a12 12 0 006 6l1.4-2L18 16v3a2 2 0 01-2.2 2A16 16 0 013 7.2 2 2 0 015 5z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
            <div class="text-left">
              <p class="text-body font-bold">{contacto.phoneLabel}</p>
              <p>
                <a class="text-body text-negro hover:underline" href={`tel:${contacto.phone.replace(/\s/g, "")}`}>
                  {contacto.phone}
                </a>
              </p>
            </div>
          </div>

          <div class="flex items-start justify-center gap-4 lg:justify-start">
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center text-brand" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"></circle>
                <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
            </span>
            <div class="text-left">
              <p class="text-body font-bold">{contacto.hoursLabel}</p>
              <p class="text-small text-negro">{contacto.hours}</p>
            </div>
          </div>
        </div>

        <a
          href={contacto.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex min-h-11 items-center gap-3 rounded-full border-2 border-brand px-6 py-3 text-small font-bold text-brand transition-colors hover:bg-brand hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 21s7-5.3 7-11a7 7 0 10-14 0c0 5.7 7 11 7 11z" stroke="currentColor" stroke-width="1.6"></path>
            <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"></circle>
          </svg>
          {contacto.mapsLabel}
        </a>
      </div>
    </div>
  </Container>
</Section>
