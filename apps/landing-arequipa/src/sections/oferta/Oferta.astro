---
import type { PageContent } from "../../content/page";
import Container from "@autonoma/ui/components/Container.astro";
import Section from "@autonoma/ui/components/Section.astro";
import IconMask from "../../components/ui/IconMask.astro";
import UPatternDecor from "../../components/ui/UPatternDecor.astro";

interface Props {
  oferta: PageContent["oferta"];
}

const { oferta } = Astro.props as Props;
---

<Section id="oferta" tone="brand" ariaLabelledby="oferta-title" class="!text-white">
  <UPatternDecor placement="oferta" side="right" />
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2 id="oferta-title" class="text-section-title-aq leading-tight reveal-lines" data-reveal-lines>
        <span class="reveal-line-mask block">
          <span class="reveal-line block font-bold lg:font-light" style="--line-delay: 0ms">{oferta.title}</span>
        </span>
        <span class="reveal-line-mask block max-lg:hidden">
          <span class="reveal-line block font-bold" style="--line-delay: 90ms">{oferta.titleAccent}</span>
        </span>
      </h2>
      <p class="mx-auto mt-4 hidden max-w-lg text-small text-white/90 lg:block" data-reveal>
        {oferta.subtitle}
      </p>
    </div>

    <div class="oferta-cards mx-auto mt-10 grid max-w-[1120px] gap-4 lg:grid-cols-2" data-reveal-stagger>
      {
        oferta.cards.map((card) => (
          <button
            type="button"
            class="oferta-card group relative flex min-h-[368px] flex-col justify-end overflow-hidden rounded-[var(--radius-card)] bg-[#a28961] p-8 text-left focus-visible:outline-none"
            data-reveal-item
            data-open-modal={card.href.includes("posgrado") ? "posgrado" : "pregrado"}
          >
            <img
              src={card.imageSrc}
              alt=""
              class="oferta-card__media absolute inset-0 size-full object-cover transition-[opacity,transform] duration-500 ease-out"
              width="551"
              height="368"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,0.95),rgba(0,0,0,0)_69.5%)]"
              aria-hidden="true"
            />

            <span
              class="absolute left-1/2 top-1/2 flex size-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-3xl font-light leading-none text-brand opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
              aria-hidden="true"
            >
              +
            </span>

            <div class="relative">
              <h3 class="text-[clamp(1.5rem,2.2vw,1.75rem)] font-bold leading-tight">{card.title}</h3>
              <p class="mt-1 max-w-[364px] text-body font-light leading-snug">{card.description}</p>
            </div>

            {/* Painted last so it sits above the image instead of being covered by it. */}
            <span
              class="pointer-events-none absolute inset-0 rounded-[var(--radius-card)] border-[3px] border-transparent transition-colors duration-300 group-hover:border-mint group-focus-visible:border-mint"
              aria-hidden="true"
            />
          </button>
        ))
      }
    </div>

    <p class="mx-auto mt-8 w-fit max-w-full rounded-full bg-white px-8 py-4 text-center text-small font-bold text-brand-dark">
      {oferta.banner}
    </p>

    <div class="mt-16 hidden text-center lg:block" data-reveal>
      <h3 class="text-h2 font-bold">{oferta.statsTitle}</h3>
      <p class="mx-auto mt-3 max-w-xl text-small text-white/90">{oferta.statsSubtitle}</p>
    </div>

    <div class="mt-10 -mx-[var(--space-section-x)] overflow-x-auto px-[var(--space-section-x)] pb-2 lg:mx-0 lg:mt-8 lg:overflow-visible lg:px-0 lg:pb-0">
      <div
        class="flex w-max gap-4 lg:grid lg:w-auto lg:grid-cols-4 lg:gap-5"
        data-reveal-stagger
      >
      {
        oferta.stats.map((stat) => {
          const match = stat.value.match(/^(\D*)(\d[\d.,]*)(.*)$/u);
          const prefix = match?.[1] ?? "";
          const numericPart = match?.[2] ?? "0";
          const suffix = match?.[3] ?? "";
          const countTo = Number(numericPart.replace(/\D/g, ""));

          return (
            <article
              class="w-[min(18rem,78vw)] shrink-0 rounded-[var(--radius-card)] bg-mint p-6 text-negro lg:w-auto lg:shrink"
              data-reveal-item
            >
              <div class="flex size-12 items-center justify-center rounded-full bg-brand">
                <IconMask src={stat.iconSrc} class="size-6 bg-white" />
              </div>
              <p
                class="mt-6 text-stat font-bold text-brand"
                data-count-to={countTo}
                data-count-prefix={prefix}
                data-count-suffix={suffix}
                data-count-final={stat.value}
              >
                {stat.value}
              </p>
              <p class="mt-2 text-small text-brand-dark">{stat.label}</p>
            </article>
          );
        })
      }
      </div>
    </div>
  </Container>
</Section>
