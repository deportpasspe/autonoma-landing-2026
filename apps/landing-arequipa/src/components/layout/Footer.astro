---
import type { SiteSettings } from "../../content/site";
import Container from "@autonoma/ui/components/Container.astro";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props as Props;
const { footer } = settings;
---

<footer class="border-t border-border bg-white py-10 text-negro">
  <Container>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div class="flex items-start gap-4">
        <span class="mt-0.5 shrink-0 text-brand" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M12 21s7-5.3 7-11a7 7 0 10-14 0c0 5.7 7 11 7 11z" stroke="currentColor" stroke-width="1.6"></path>
            <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"></circle>
          </svg>
        </span>
        <div>
          <p class="text-body font-bold">{footer.addressLabel}</p>
          <a
            class="mt-1 block text-small text-negro hover:underline"
            href={footer.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {footer.address}
          </a>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <span class="mt-0.5 shrink-0 text-brand" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path
              d="M4 5h3l1.6 4.2-2 1.4a12 12 0 006 6l1.4-2L18 16v3a2 2 0 01-2.2 2A16 16 0 013 7.2 2 2 0 015 5z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <div>
          <p class="text-body font-bold">{footer.phoneLabel}</p>
          <a class="mt-1 block text-small text-negro hover:underline" href={`tel:${footer.phone.replace(/\s/g, "")}`}>
            {footer.phone}
          </a>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <span class="mt-0.5 shrink-0 text-brand" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"></rect>
            <path d="M3.5 6.5L12 13l8.5-6.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          </svg>
        </span>
        <div>
          <p class="text-body font-bold">{footer.emailLabel}</p>
          <a class="mt-1 block text-small text-negro hover:underline" href={`mailto:${footer.email}`}>
            {footer.email}
          </a>
        </div>
      </div>
    </div>

    <p class="mt-10 border-t border-border pt-6 text-caption text-text-muted">
      © {new Date().getFullYear()} Universidad Autónoma del Perú. Todos los derechos reservados.
    </p>
  </Container>
</footer>
