---
/**
 * Shared modal open/close wiring for header mega-menu and oferta cards.
 */
---

<script>
  function getModal(id: string): HTMLDialogElement | null {
    return document.querySelector<HTMLDialogElement>(`[data-modal="${id}"]`);
  }

  function openModal(id: string) {
    const dialog = getModal(id);
    if (!dialog) return;
    if (typeof dialog.showModal === "function") dialog.showModal();
    else dialog.setAttribute("open", "");
  }

  function closeModal(dialog: HTMLDialogElement) {
    if (typeof dialog.close === "function") dialog.close();
    else dialog.removeAttribute("open");
  }

  document.addEventListener("open-modal", ((event: CustomEvent<{ id: string }>) => {
    openModal(event.detail.id);
  }) as EventListener);

  document.querySelectorAll<HTMLElement>("[data-open-modal]").forEach((el) => {
    el.addEventListener("click", (e) => {
      const id = el.getAttribute("data-open-modal");
      if (!id) return;
      if (el.tagName === "A") e.preventDefault();
      openModal(id);
    });
  });

  document.querySelectorAll("dialog[data-modal]").forEach((dialog) => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.querySelectorAll("[data-modal-close]").forEach((btn) => {
      btn.addEventListener("click", () => closeModal(dialog));
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeModal(dialog);
    });
  });
</script>
