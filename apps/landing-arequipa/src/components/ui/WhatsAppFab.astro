---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp — 1 mensaje nuevo"
>
  <span class="wa-fab__pulse" aria-hidden="true"></span>
  <span class="wa-fab__pulse wa-fab__pulse--delayed" aria-hidden="true"></span>
  <svg
    class="wa-fab__icon"
    viewBox="0 0 32 32"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M16.04 4C9.4 4 4 9.34 4 15.9c0 2.1.55 4.15 1.6 5.96L4 28l6.32-1.65A12.05 12.05 0 0 0 16.04 28C22.68 28 28 22.66 28 16.1S22.68 4 16.04 4Zm0 21.85c-1.9 0-3.76-.5-5.39-1.46l-.39-.23-3.75.98 1-3.65-.25-.38a9.84 9.84 0 0 1-1.53-5.21c0-5.43 4.48-9.85 10-9.85s10 4.42 10 9.85-4.48 9.95-10 9.95Zm5.48-7.38c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.96 1.17-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.63-.93-2.23-.24-.58-.5-.5-.68-.51h-.58c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.49s1.07 2.89 1.22 3.09c.15.2 2.11 3.22 5.11 4.51.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.18-1.42-.08-.13-.27-.2-.57-.35Z"
    ></path>
  </svg>
  <span class="wa-fab__badge" aria-hidden="true">
    <span class="wa-fab__badge-ping"></span>
    <span class="wa-fab__badge-dot">1</span>
  </span>
</a>

<style>
  .wa-fab {
    --wa: #25d366;
    --wa-badge: #ff3b30;
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 9999px;
    color: #fff;
    background: var(--wa);
    box-shadow:
      0 4px 12px rgb(0 0 0 / 0.12),
      0 8px 24px rgb(37 211 102 / 0.35);
    animation: wa-fab-bounce 2.2s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
    transition: box-shadow 180ms ease;
  }

  .wa-fab:hover {
    animation-play-state: paused;
    transform: scale(1.06);
    box-shadow:
      0 6px 16px rgb(0 0 0 / 0.14),
      0 10px 28px rgb(37 211 102 / 0.45);
  }

  .wa-fab:focus-visible {
    outline: 2px solid #128c7e;
    outline-offset: 3px;
  }

  .wa-fab__icon {
    position: relative;
    z-index: 1;
    width: 2.35rem;
    height: 2.35rem;
  }

  /* Contenedor anclado al vértice superior derecho del botón */
  .wa-fab__badge {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 3;
    width: 1.375rem;
    height: 1.375rem;
    transform: translate(28%, -28%);
    pointer-events: none;
  }

  .wa-fab__badge-ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--wa-badge);
    opacity: 0.55;
    animation: wa-fab-badge-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .wa-fab__badge-dot {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid #fff;
    background: var(--wa-badge);
    color: #fff;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: 0;
    /* Compensa la métrica tipográfica: el “1” se ve ópticamente bajo. */
    padding-bottom: 0.08em;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.22);
  }

  .wa-fab__pulse {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--wa);
    animation: wa-fab-pulse 2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
    pointer-events: none;
  }

  .wa-fab__pulse--delayed {
    animation-delay: 1s;
  }

  @keyframes wa-fab-bounce {
    0%,
    55%,
    100% {
      transform: translateY(0);
    }
    62% {
      transform: translateY(-14px);
    }
    70% {
      transform: translateY(0);
    }
    76% {
      transform: translateY(-8px);
    }
    84% {
      transform: translateY(0);
    }
    90% {
      transform: translateY(-3px);
    }
    96% {
      transform: translateY(0);
    }
  }

  @keyframes wa-fab-badge-ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    75%,
    100% {
      transform: scale(1.85);
      opacity: 0;
    }
  }

  @keyframes wa-fab-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70% {
      transform: scale(1.65);
      opacity: 0;
    }
    100% {
      transform: scale(1.65);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab {
      animation: none;
    }

    .wa-fab__pulse,
    .wa-fab__badge-ping {
      animation: none;
      opacity: 0;
    }

    .wa-fab:hover {
      transform: none;
    }
  }
</style>
