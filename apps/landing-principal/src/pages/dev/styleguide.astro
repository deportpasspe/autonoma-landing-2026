---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "@autonoma/ui/components/Container.astro";
import Section from "@autonoma/ui/components/Section.astro";
import Heading from "@autonoma/ui/components/Heading.astro";
import Tag from "@autonoma/ui/components/Tag.astro";
import Button from "@autonoma/ui/components/Button.astro";

const meta = {
  title: "Styleguide — Autónoma",
  description: "UI primitives reference",
  canonical: "http://localhost:4321/dev/styleguide",
};
---

<BaseLayout {...meta}>
  <Section tone="white">
    <Container>
      <Heading as="h1" size="display">Styleguide</Heading>
      <p class="mt-4 text-body text-text-muted">Tokens Universidad Autónoma del Perú</p>
    </Container>
  </Section>
  <Section tone="lavender">
    <Container class="flex flex-col gap-8">
      <div>
        <Tag>Tipografía</Tag>
        <Heading size="hero" class="mt-4">Hero</Heading>
        <Heading size="h2" class="mt-4">Section</Heading>
      </div>
      <div class="flex flex-wrap gap-4">
        <Button variant="brand">Brand</Button>
        <Button variant="primary">Primary</Button>
        <Button variant="secondary">Secondary</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>
