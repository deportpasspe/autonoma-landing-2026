---
import type { HeroSection, Page, SiteSettings } from "../lib/cms/types";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import RegistrationForm from "../components/forms/RegistrationForm.astro";
import SectionBuilder from "../sections/SectionBuilder.astro";
import Hero from "../sections/hero/Hero.astro";

interface Props {
  page: Page;
  settings: SiteSettings;
}

const { page, settings } = Astro.props as Props;

const hero = page.sections.find((section): section is HeroSection => section._type === "hero");
const stickyRest = page.sections.filter(
  (section) => section._type !== "hero" && section._type !== "campus",
);
const afterSections = page.sections.filter((section) => section._type === "campus");
---

<Header settings={settings} />
<main id="main-content">
  <div id="sticky-lead-zone" class="relative flex flex-col">
    {hero && <div class="order-1"><Hero {...hero} formRail /></div>}

    {
      hero && (
        <div
          class="order-2 bg-brand px-[var(--space-section-x)] pb-10 pt-2 lg:pointer-events-none lg:absolute lg:inset-y-0 lg:left-0 lg:right-0 lg:z-20 lg:flex lg:bg-transparent lg:px-0 lg:pb-0 lg:pt-0"
          aria-label="Formulario de registro"
        >
          <div class="mx-auto flex w-full max-w-[var(--page-max)] justify-center lg:h-full lg:justify-end lg:px-[var(--space-section-x)]">
            <div
              data-sticky-form-rail
              data-reveal
              class="-mt-4 w-full sm:-mt-6 lg:pointer-events-auto lg:sticky lg:top-24 lg:mt-0 lg:h-fit lg:w-[var(--form-rail)]"
            >
              <RegistrationForm
                formTitle={hero.formTitle}
                formSubtitle={hero.formSubtitle}
                formSubmitLabel={hero.formSubmitLabel}
                modalities={hero.modalities}
                campuses={hero.campuses}
                careers={hero.careers}
                class="mx-auto w-full lg:max-w-[var(--form-card)]"
              />
            </div>
          </div>
        </div>
      )
    }

    <div class="order-3">
      <SectionBuilder sections={stickyRest} formRail />
    </div>
  </div>

  <SectionBuilder sections={afterSections} />
</main>
<Footer settings={settings} />

{
  hero && (
    <script>
      function syncStickyFormCenter() {
        const heroEl = document.getElementById("inicio");
        const zone = document.getElementById("sticky-lead-zone");
        const rail = document.querySelector("[data-sticky-form-rail]");
        const media = document.querySelector("[data-hero-media]");
        if (!(rail instanceof HTMLElement) || !heroEl || !zone) return;

        if (!window.matchMedia("(min-width: 1024px)").matches) {
          rail.style.marginTop = "";
          return;
        }

        const mediaEl = media instanceof HTMLElement ? media : heroEl;
        const zoneTop = zone.getBoundingClientRect().top + window.scrollY;
        const mediaRect = mediaEl.getBoundingClientRect();
        const mediaTop = mediaRect.top + window.scrollY;
        const mediaHeight = mediaEl.offsetHeight;
        const formHeight = rail.offsetHeight;

        // Center the form against the left hero media block (document coords → zone offset)
        const mediaCenter = mediaTop - zoneTop + mediaHeight / 2;
        const marginTop = Math.max(0, mediaCenter - formHeight / 2);
        rail.style.marginTop = `${marginTop}px`;
      }

      const run = () => requestAnimationFrame(syncStickyFormCenter);
      run();
      window.addEventListener("load", run);
      window.addEventListener("resize", run);

      const heroEl = document.getElementById("inicio");
      const rail = document.querySelector("[data-sticky-form-rail]");
      const media = document.querySelector("[data-hero-media]");
      const ro = new ResizeObserver(run);
      if (heroEl) ro.observe(heroEl);
      if (rail) ro.observe(rail);
      if (media) ro.observe(media);
    </script>
  )
}
