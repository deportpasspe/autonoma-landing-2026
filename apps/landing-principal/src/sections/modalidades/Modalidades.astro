---
import type { ModalidadesSection } from "../../lib/cms/types";
import Container from "@autonoma/ui/components/Container.astro";
import Section from "@autonoma/ui/components/Section.astro";
import Tag from "@autonoma/ui/components/Tag.astro";

interface Props extends ModalidadesSection {
  formRail?: boolean;
}

const { eyebrow, title, subtitle, items, formRail = false } = Astro.props as Props;
---

<Section id="modalidades" tone="brand" ariaLabelledby="modalidades-title" formRail={formRail}>
  <Container formRail={formRail}>
    <div class="mb-10 max-w-3xl lg:max-w-none" data-reveal>
      <Tag class="!text-white">{eyebrow}</Tag>
      <h2 id="modalidades-title" class="mt-2 text-section-title text-white">{title}</h2>
      <p class="mt-3 text-[clamp(1.125rem,1.2vw+0.5rem,1.75rem)] font-semibold leading-normal text-white lg:whitespace-nowrap">
        {subtitle}
      </p>
    </div>

    <ul class="grid w-full gap-4 md:grid-cols-3" data-reveal-stagger>
      {
        items.map((item) => (
          <li
            class="card-lift relative flex min-h-[392px] flex-col justify-end overflow-hidden rounded-xl text-negro"
            data-reveal-item
          >
            <img
              src={item.imageSrc}
              alt={item.imageAlt}
              class="absolute inset-0 size-full object-cover object-top"
              width="424"
              height="576"
              loading="lazy"
              data-card-media
            />
            <div class="relative z-10 flex flex-col gap-2.5 bg-white p-3">
              <span class="inline-flex w-fit items-center justify-center rounded-md bg-brand px-4 py-2.5 text-caption font-bold uppercase text-white">
                {item.name}
              </span>
              <p class="text-[18px] font-bold leading-normal text-negro">{item.description}</p>
              <p class="text-small font-bold leading-[1.55] text-brand">{item.schedule}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
