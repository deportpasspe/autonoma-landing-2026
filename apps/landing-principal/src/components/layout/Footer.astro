---
import type { SiteSettings } from "../../lib/cms/types";
import Container from "@autonoma/ui/components/Container.astro";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props as Props;
const { footer } = settings;
---

<footer class="border-t border-border bg-white py-10 text-negro">
  <Container>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        footer.campuses.map((campus) => (
          <div class="flex gap-3">
            <svg class="mt-1 size-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 21s7-5.2 7-11a7 7 0 10-14 0c0 5.8 7 11 7 11z" stroke="currentColor" stroke-width="2" />
              <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="2" />
            </svg>
            <div>
              <p class="font-bold">{campus.name}</p>
              <p class="mt-1 text-small text-text-muted">{campus.address}</p>
            </div>
          </div>
        ))
      }
      <div class="flex gap-3">
        <svg class="mt-1 size-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.5 4h3l1.5 5-2 1.5a12 12 0 006 6L16.5 13l5 1.5v3A2.5 2.5 0 0119 20 15 15 0 014 5a2.5 2.5 0 012.5-1z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
        <div>
          <p class="font-bold">{footer.phone.label}</p>
          <a class="mt-1 block text-small hover:underline" href={`tel:${footer.phone.value}`}>{footer.phone.value}</a>
        </div>
      </div>
      <div class="flex gap-3">
        <svg class="mt-1 size-5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2" />
          <path d="M3 7l9 7 9-7" stroke="currentColor" stroke-width="2" />
        </svg>
        <div>
          <p class="font-bold">{footer.email.label}</p>
          <a class="mt-1 block text-small hover:underline" href={`mailto:${footer.email.value}`}>{footer.email.value}</a>
        </div>
      </div>
    </div>
  </Container>
</footer>
