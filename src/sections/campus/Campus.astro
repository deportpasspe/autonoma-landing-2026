---
import type { CampusSection } from "../../lib/cms/types";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Tag from "../../components/ui/Tag.astro";

interface Props extends CampusSection {}

const { eyebrow, title, subtitle, campuses } = Astro.props as Props;
---

<Section id="campus" tone="white" ariaLabelledby="campus-title" class="!pb-8">
  <Container>
    <div class="mx-auto mb-10 max-w-4xl text-center" data-reveal>
      <Tag class="justify-center">{eyebrow}</Tag>
      <h2 id="campus-title" class="mt-3 text-section-title text-brand">{title}</h2>
      <p class="mt-4 text-[clamp(1rem,2vw,1.25rem)] text-text-muted">{subtitle}</p>
    </div>

    <ul class="grid gap-5 lg:grid-cols-2" data-reveal>
      {
        campuses.map((campus) => (
          <li class="relative overflow-hidden rounded-[var(--radius-card)] bg-negro/5">
            <div class="relative aspect-[638/512]" data-campus-slider>
              {campus.images.map((image, index) => (
                <div
                  class:list={["absolute inset-0", index !== 0 && "hidden"]}
                  data-campus-slide
                  data-index={index}
                  hidden={index !== 0}
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="h-full w-full object-cover"
                    width="638"
                    height="512"
                    loading="lazy"
                  />
                </div>
              ))}

              {/* Orange name rail — Figma 10:1934 / 10:1935 */}
              <div class="pointer-events-none absolute inset-y-0 left-0 z-20 w-[90px] rounded-r-[19px] bg-brand">
                <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rotate-180 text-[20px] font-bold uppercase tracking-wide text-white [writing-mode:vertical-rl]">
                  {campus.name}
                </span>
              </div>

              {/* Slider controls — Figma 10:1938 / 10:1941 */}
              <div class="absolute inset-x-0 bottom-6 z-20 flex items-center justify-center gap-6">
                <button
                  type="button"
                  class="inline-flex size-[42px] items-center justify-center text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                  aria-label={`${campus.name}: imagen anterior`}
                  data-campus-prev
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>

                <div
                  class="flex items-center gap-[14px]"
                  role="tablist"
                  aria-label={`Paginación de imágenes — ${campus.name}`}
                >
                  {campus.images.map((_, index) => (
                    <button
                      type="button"
                      class:list={[
                        "size-4 rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand",
                        index === 0 ? "bg-white" : "bg-white/50",
                      ]}
                      role="tab"
                      aria-selected={index === 0 ? "true" : "false"}
                      aria-label={`${campus.name}, imagen ${index + 1}`}
                      data-campus-dot
                      data-index={index}
                    />
                  ))}
                </div>

                <button
                  type="button"
                  class="inline-flex size-[42px] items-center justify-center text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                  aria-label={`${campus.name}: imagen siguiente`}
                  data-campus-next
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>

<script>
  function showSlide(slider: HTMLElement, index: number) {
    const slides = [...slider.querySelectorAll<HTMLElement>("[data-campus-slide]")];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>("[data-campus-dot]")];
    if (!slides.length) return;

    const nextIndex = ((index % slides.length) + slides.length) % slides.length;

    slides.forEach((slide, i) => {
      const active = i === nextIndex;
      slide.classList.toggle("hidden", !active);
      slide.hidden = !active;
    });

    dots.forEach((dot, i) => {
      const active = i === nextIndex;
      dot.setAttribute("aria-selected", active ? "true" : "false");
      dot.classList.toggle("bg-white", active);
      dot.classList.toggle("bg-white/50", !active);
    });

    slider.dataset.activeIndex = String(nextIndex);
  }

  function currentIndex(slider: HTMLElement) {
    return Number(slider.dataset.activeIndex || "0");
  }

  document.querySelectorAll<HTMLElement>("#campus [data-campus-slider]").forEach((slider) => {
    slider.dataset.activeIndex = "0";

    slider.querySelectorAll<HTMLButtonElement>("[data-campus-dot]").forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = Number(dot.dataset.index);
        if (Number.isNaN(index)) return;
        showSlide(slider, index);
      });
    });

    slider.querySelector("[data-campus-prev]")?.addEventListener("click", () => {
      showSlide(slider, currentIndex(slider) - 1);
    });

    slider.querySelector("[data-campus-next]")?.addEventListener("click", () => {
      showSlide(slider, currentIndex(slider) + 1);
    });
  });
</script>
