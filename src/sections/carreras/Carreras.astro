---
import type { CarrerasSection } from "../../lib/cms/types";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Tag from "../../components/ui/Tag.astro";

interface Props extends CarrerasSection {
  formRail?: boolean;
}

const { eyebrow, title, subtitle, groups, formRail = false } = Astro.props as Props;
---

<Section id="carreras" tone="yellow" ariaLabelledby="carreras-title" formRail={formRail}>
  <Container formRail={formRail}>
    <div class="mb-10 max-w-3xl" data-reveal>
      <Tag>{eyebrow}</Tag>
      <h2 id="carreras-title" class="mt-3 text-section-title text-brand">{title}</h2>
      <p class="mt-4 text-[clamp(1.125rem,1.2vw+0.5rem,1.75rem)] font-semibold leading-normal text-brand">
        {subtitle}
      </p>
    </div>

    <div class="flex w-full flex-col gap-3" data-reveal-stagger data-accordion>
      {
        groups.map((group, index) => {
          const open = index === 0;
          return (
            <div
              class="overflow-hidden rounded-xl"
              data-accordion-item
              data-open={open ? "true" : "false"}
              data-reveal-item
            >
              <button
                type="button"
                class:list={[
                  "group flex min-h-[54px] w-full items-center justify-between px-4 py-3.5 text-left text-[18px] transition-[background-color,color,border-color,transform] duration-300 ease-[var(--ease-out)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand",
                  open
                    ? "rounded-xl bg-brand font-bold text-white"
                    : "rounded-xl border border-brand bg-transparent font-normal text-negro hover:bg-brand/10",
                ]}
                aria-expanded={open ? "true" : "false"}
                data-accordion-trigger
              >
                <span class="inline-flex items-center gap-2.5">
                  <span data-accordion-label>{group.name}</span>
                  <span
                    class:list={[
                      "hidden text-[12px] leading-none opacity-80 sm:inline",
                      open ? "text-white" : "text-brand",
                    ]}
                    aria-hidden="true"
                    data-accordion-brace
                  >
                    {"{"}
                  </span>
                </span>
                <svg
                  class:list={[
                    "size-[22px] shrink-0 transition-transform duration-300 ease-[var(--ease-out)]",
                    open && "rotate-180",
                  ]}
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  data-accordion-icon
                >
                  <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </button>

              <div
                class:list={[
                  "grid transition-[grid-template-rows] duration-300 ease-[var(--ease-out)]",
                  open ? "grid-rows-[1fr]" : "grid-rows-[0fr]",
                ]}
                data-accordion-panel
              >
                <div class="min-h-0 overflow-hidden">
                  <div class="pt-2.5">
                    <ul class="rounded-xl bg-white p-4">
                      {
                        (group.items ?? []).map((item) => (
                          <li>
                            <button
                              type="button"
                              class="flex w-full items-center gap-3 rounded-lg px-1 py-2 text-left text-[16px] text-negro transition-colors duration-200 hover:text-brand hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                            >
                              <span class="size-1.5 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
                              <span>{item}</span>
                            </button>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </Container>
</Section>

<style>
  @media (prefers-reduced-motion: reduce) {
    #carreras [data-accordion-item] button,
    #carreras [data-accordion-panel],
    #carreras [data-accordion-icon] {
      transition: none !important;
    }
  }
</style>

<script>
  function setOpen(item: HTMLElement, open: boolean) {
    const trigger = item.querySelector<HTMLButtonElement>("[data-accordion-trigger]");
    const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
    const icon = item.querySelector<SVGElement>("[data-accordion-icon]");
    const brace = item.querySelector<HTMLElement>("[data-accordion-brace]");
    if (!trigger || !panel) return;

    item.dataset.open = open ? "true" : "false";
    trigger.setAttribute("aria-expanded", open ? "true" : "false");

    trigger.classList.toggle("bg-brand", open);
    trigger.classList.toggle("font-bold", open);
    trigger.classList.toggle("text-white", open);
    trigger.classList.toggle("border", !open);
    trigger.classList.toggle("border-brand", !open);
    trigger.classList.toggle("bg-transparent", !open);
    trigger.classList.toggle("font-normal", !open);
    trigger.classList.toggle("text-negro", !open);
    trigger.classList.toggle("hover:bg-brand/10", !open);

    panel.classList.toggle("grid-rows-[1fr]", open);
    panel.classList.toggle("grid-rows-[0fr]", !open);

    icon?.classList.toggle("rotate-180", open);

    if (brace) {
      brace.classList.toggle("text-white", open);
      brace.classList.toggle("text-brand", !open);
    }
  }

  document.querySelectorAll("#carreras [data-accordion]").forEach((root) => {
    root.querySelectorAll("[data-accordion-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const item = trigger.closest<HTMLElement>("[data-accordion-item]");
        if (!item) return;
        const isOpen = item.dataset.open === "true";

        root.querySelectorAll<HTMLElement>("[data-accordion-item]").forEach((other) => {
          setOpen(other, false);
        });

        if (!isOpen) setOpen(item, true);
      });
    });
  });
</script>
