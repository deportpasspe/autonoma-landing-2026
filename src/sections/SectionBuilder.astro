---
import type { PageSection } from "../lib/cms/types";
import Hero from "./hero/Hero.astro";
import Desafiar from "./desafiar/Desafiar.astro";
import Resultados from "./resultados/Resultados.astro";
import Carreras from "./carreras/Carreras.astro";
import Modalidades from "./modalidades/Modalidades.astro";
import PropioCamino from "./propio-camino/PropioCamino.astro";
import Testimonios from "./testimonios/Testimonios.astro";
import Campus from "./campus/Campus.astro";

interface Props {
  sections: PageSection[];
  formRail?: boolean;
}

const { sections, formRail = false } = Astro.props as Props;
---

{
  sections.map((block) => {
    switch (block._type) {
      case "hero":
        return <Hero {...block} formRail={formRail} />;
      case "desafiar":
        return <Desafiar {...block} formRail={formRail} />;
      case "resultados":
        return <Resultados {...block} formRail={formRail} />;
      case "carreras":
        return <Carreras {...block} formRail={formRail} />;
      case "modalidades":
        return <Modalidades {...block} formRail={formRail} />;
      case "propioCamino":
        return <PropioCamino {...block} formRail={formRail} />;
      case "testimonios":
        return <Testimonios {...block} formRail={formRail} />;
      case "campus":
        return <Campus {...block} />;
      default:
        return null;
    }
  })
}
