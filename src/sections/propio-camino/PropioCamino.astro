---
import type { PropioCaminoSection } from "../../lib/cms/types";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Tag from "../../components/ui/Tag.astro";

interface Props extends PropioCaminoSection {
  formRail?: boolean;
}

const { eyebrow, title, features, imageSrc, imageAlt, formRail = false } = Astro.props as Props;

const tones = {
  sky: "bg-sky",
  mint: "bg-mint",
  lavender: "bg-lavender",
};
---

<Section
  id="camino"
  tone="brand"
  ariaLabelledby="camino-title"
  class="overflow-hidden !pb-0"
  formRail={formRail}
>
  <Container formRail={formRail}>
    <div class="mb-10 max-w-[min(100%,clamp(37.5rem,36vw,45rem))]" data-reveal>
      <Tag class="!text-white">{eyebrow}</Tag>
      <h2 id="camino-title" class="mt-3 text-section-title text-white">{title}</h2>
    </div>

    <div class="grid w-full gap-8 lg:grid-cols-[1.1fr_minmax(0,1fr)] lg:items-end">
      <ul
        class="flex w-full flex-col gap-4 self-start pb-8 lg:pb-[var(--space-section-y)]"
        data-reveal-stagger
      >
        {
          features.map((feature) => (
            <li
              class:list={[
                "card-lift flex items-center gap-3 rounded-2xl px-4 py-6",
                tones[feature.tone],
              ]}
              data-reveal-item
            >
              <div class="flex size-[clamp(4rem,4.5vw,5rem)] shrink-0 items-center justify-center rounded-xl bg-white p-3.5">
                <img
                  src={feature.iconSrc}
                  alt=""
                  width="32"
                  height="32"
                  class="size-8 object-contain"
                  aria-hidden="true"
                />
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[clamp(1.125rem,1.1vw+0.5rem,1.375rem)] font-bold leading-[1.1] text-brand">{feature.title}</p>
                <p class="mt-3.5 text-small font-bold leading-[1.1] text-negro">{feature.lead}</p>
                <p class="mt-2 text-small leading-[1.1] text-negro">{feature.description}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="relative mx-auto hidden w-full self-end lg:mx-0 lg:block lg:justify-self-end" data-reveal>
        <img
          src={imageSrc}
          alt={imageAlt}
          class="mx-auto block h-auto w-full max-w-md object-contain object-bottom lg:max-w-none"
          width="465"
          height="589"
          loading="lazy"
        />
      </div>
    </div>
  </Container>
</Section>
