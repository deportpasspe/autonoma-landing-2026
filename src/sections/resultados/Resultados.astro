---
import type { ResultadosSection } from "../../lib/cms/types";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Tag from "../../components/ui/Tag.astro";

interface Props extends ResultadosSection {
  formRail?: boolean;
}

const { eyebrow, title, stats, formRail = false } = Astro.props as Props;

const tones = {
  yellow: "bg-yellow",
  mint: "bg-mint",
  lavender: "bg-lavender",
  sky: "bg-sky",
};

const sourceTones = {
  yellow: "text-[#80712b]",
  mint: "text-[#5b7a49]",
  lavender: "text-[#656480]",
  sky: "text-[#497480]",
};
---

<Section id="cifras" tone="brand" ariaLabelledby="cifras-title" formRail={formRail}>
  <Container formRail={formRail}>
    <div class="mb-8 max-w-[min(100%,clamp(37.5rem,36vw,45rem))]" data-reveal>
      <Tag class="!text-white">{eyebrow}</Tag>
      <h2 id="cifras-title" class="mt-2.5 text-section-title text-white">{title}</h2>
    </div>

    <ul class="grid max-w-content-lead grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        stats.map((stat) => (
          <li
            class:list={[
              "flex min-h-[clamp(13.9rem,14vw,16rem)] flex-col gap-4 rounded-xl px-3.5 py-4 text-negro",
              tones[stat.tone],
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <p class="text-stat font-bold uppercase leading-[1.1] text-brand">{stat.value}</p>
              <img
                src={stat.iconSrc}
                alt=""
                width="36"
                height="36"
                class="size-[clamp(2.25rem,2.2vw,2.75rem)] shrink-0 object-contain"
                aria-hidden="true"
              />
            </div>
            <p class="text-[clamp(1rem,1vw+0.5rem,1.25rem)] font-semibold leading-[1.1] text-brand">{stat.label}</p>
            <p class="text-small leading-[1.1] text-negro/95">{stat.description}</p>
            <p class:list={["mt-auto text-[12px] leading-[1.1]", sourceTones[stat.tone]]}>
              {stat.source}
            </p>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
