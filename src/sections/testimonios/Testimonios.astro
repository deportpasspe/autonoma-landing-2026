---
import type { TestimoniosSection } from "../../lib/cms/types";
import Container from "../../components/ui/Container.astro";
import Section from "../../components/ui/Section.astro";
import Tag from "../../components/ui/Tag.astro";

interface Props extends TestimoniosSection {
  formRail?: boolean;
}

const { eyebrow, title, items, formRail = false } = Astro.props as Props;

function youtubeIdFromUrl(url: string): string | null {
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes("youtu.be")) {
      return parsed.pathname.replace("/", "") || null;
    }
    return parsed.searchParams.get("v");
  } catch {
    return null;
  }
}
---

<Section id="testimonios" tone="sky" ariaLabelledby="testimonios-title" class="overflow-hidden" formRail={formRail}>
  <Container formRail={formRail}>
    <div class="mb-8 max-w-content-lead" data-reveal>
      <Tag>{eyebrow}</Tag>
      <h2 id="testimonios-title" class="mt-3 text-section-title text-brand">{title}</h2>
    </div>

    <div class="relative w-full" data-reveal data-testimonios-slider>
      {
        items.map((item, index) => {
          const youtubeId = youtubeIdFromUrl(item.youtubeUrl);
          return (
            <div
              class:list={["relative", index !== 0 && "hidden"]}
              data-testimonio-slide
              data-index={index}
              hidden={index !== 0}
            >
              <div class="relative pointer-events-none">
                <div class="relative">
                  <div class="relative aspect-[588/197] w-full overflow-hidden rounded-xl bg-negro/20">
                    <img
                      src={item.videoSrc}
                      alt={item.videoAlt}
                      class="absolute inset-0 size-full object-cover"
                      width="588"
                      height="197"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-black/20"></div>
                    <span
                      class:list={[
                        "absolute left-1/2 top-1/2 inline-flex size-[42px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-brand text-white",
                        !youtubeId && "opacity-50",
                      ]}
                      aria-hidden="true"
                    >
                      <svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor" aria-hidden="true">
                        <path d="M1 1.5v15l14-7.5L1 1.5z"></path>
                      </svg>
                    </span>
                  </div>

                  <p
                    class="absolute -left-1 bottom-0 translate-y-[40%] text-[clamp(6rem,12vw,15rem)] font-bold leading-none text-brand/90"
                    aria-hidden="true"
                  >
                    “
                  </p>
                </div>

                <blockquote class="relative z-10 mt-10 max-w-xl">
                  <p class="text-[1.25rem] leading-normal text-negro">“{item.quote}”</p>
                  <footer class="mt-6">
                    <p class="text-[1.25rem] font-bold text-brand">{item.author}</p>
                    <p class="mt-1 text-body text-negro">{item.role}</p>
                  </footer>
                </blockquote>
              </div>

              <button
                type="button"
                class="absolute inset-0 z-20 cursor-pointer rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:cursor-not-allowed"
                aria-label={`Reproducir testimonio de ${item.author}`}
                data-video-modal-open
                data-youtube-id={youtubeId ?? undefined}
                data-video-title={`Testimonio de ${item.author}`}
                disabled={!youtubeId}
              ></button>
            </div>
          );
        })
      }

      <div class="mt-8 flex gap-4" role="tablist" aria-label="Paginación de testimonios">
        {
          items.map((item, index) => (
            <button
              type="button"
              class:list={[
                "size-4 rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand",
                index === 0 ? "bg-brand" : "bg-white",
              ]}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-label={`Ver testimonio ${index + 1}: ${item.author}`}
              data-testimonio-dot
              data-index={index}
            ></button>
          ))
        }
      </div>
    </div>
  </Container>
</Section>

<dialog
  id="testimonio-video-modal"
  class="fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none border-0 bg-transparent p-4 open:flex open:items-center open:justify-center backdrop:bg-negro/70"
  aria-label="Video de testimonio"
>
  <div class="relative w-full max-w-4xl overflow-hidden rounded-2xl bg-negro shadow-2xl" data-video-modal-panel>
    <button
      type="button"
      class="absolute right-3 top-3 z-10 inline-flex size-10 items-center justify-center rounded-full bg-negro/70 text-white hover:bg-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      aria-label="Cerrar video"
      data-video-modal-close
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    <div class="relative aspect-video w-full bg-negro" data-video-modal-frame></div>
  </div>
</dialog>

<script>
  function showSlide(slider: HTMLElement, index: number) {
    const slides = [...slider.querySelectorAll<HTMLElement>("[data-testimonio-slide]")];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>("[data-testimonio-dot]")];

    slides.forEach((slide, i) => {
      const active = i === index;
      slide.classList.toggle("hidden", !active);
      slide.hidden = !active;
    });

    dots.forEach((dot, i) => {
      const active = i === index;
      dot.setAttribute("aria-selected", active ? "true" : "false");
      dot.classList.toggle("bg-brand", active);
      dot.classList.toggle("bg-white", !active);
    });
  }

  const modal = document.querySelector<HTMLDialogElement>("#testimonio-video-modal");
  const frame = modal?.querySelector<HTMLElement>("[data-video-modal-frame]");

  function closeVideoModal() {
    if (!modal || !frame) return;
    frame.innerHTML = "";
    if (modal.open) modal.close();
    document.body.classList.remove("overflow-hidden");
  }

  function openVideoModal(youtubeId: string, title: string) {
    if (!modal || !frame) return;

    frame.innerHTML = "";
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?autoplay=1&rel=0&modestbranding=1`;
    iframe.title = title;
    iframe.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    iframe.allowFullscreen = true;
    iframe.className = "absolute inset-0 size-full border-0";
    frame.appendChild(iframe);

    if (!modal.open) modal.showModal();
    document.body.classList.add("overflow-hidden");
  }

  document.querySelectorAll<HTMLElement>("[data-testimonios-slider]").forEach((slider) => {
    slider.querySelectorAll<HTMLButtonElement>("[data-video-modal-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.youtubeId;
        if (!id) return;
        openVideoModal(id, btn.dataset.videoTitle || "Testimonio Universidad Autónoma");
      });
    });

    slider.querySelectorAll<HTMLButtonElement>("[data-testimonio-dot]").forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = Number(dot.dataset.index);
        if (Number.isNaN(index)) return;
        showSlide(slider, index);
      });
    });
  });

  modal?.querySelectorAll("[data-video-modal-close]").forEach((btn) => {
    btn.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      closeVideoModal();
    });
  });

  modal?.addEventListener("click", (event) => {
    const panel = modal.querySelector("[data-video-modal-panel]");
    if (!panel) return;
    if (event.target === modal || !panel.contains(event.target as Node)) {
      closeVideoModal();
    }
  });

  modal?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeVideoModal();
  });

  modal?.addEventListener("close", () => {
    if (frame) frame.innerHTML = "";
    document.body.classList.remove("overflow-hidden");
  });
</script>
