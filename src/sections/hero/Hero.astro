---
import type { HeroSection } from "../../lib/cms/types";
import BrandCoverBg from "../../components/ui/BrandCoverBg.astro";
import Container from "../../components/ui/Container.astro";

interface Props extends HeroSection {
  formRail?: boolean;
}

const { line1, line2, line3, line4, imageSrc, imageAlt, formRail = false } = Astro.props as Props;
---

<section
  id="inicio"
  class="section-noise relative overflow-hidden bg-brand pt-[95px] text-white"
  aria-labelledby="hero-title"
>
  <BrandCoverBg eager />
  <Container
    formRail={formRail}
    class="relative z-10 pb-6 pt-6 md:pb-8 md:pt-8 lg:pb-[var(--space-section-y)] lg:pt-12"
  >
    <div class="relative w-full" data-reveal>
      <div class="@container relative w-full overflow-hidden rounded-[var(--radius-card)] lg:rounded-none lg:overflow-visible">
        <img
          src={imageSrc}
          alt={imageAlt}
          class="block h-auto w-full"
          width="856"
          height="527"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <h1
          id="hero-title"
          class="absolute left-[8%] top-[16%] z-10 flex w-[min(48%,18rem)] min-w-[11rem] max-w-[min(18rem,52%)] flex-col leading-[0.95] sm:left-[11.4%] sm:top-[18.1%] sm:w-[34%] sm:min-w-[12rem] sm:max-w-[min(16.75rem,34%)]"
        >
          <span class="text-[length:clamp(1.75rem,11.75cqw,7.5rem)] font-bold text-white">
            {line1}
          </span>
          <span class="whitespace-nowrap text-[length:clamp(1rem,6.3cqw,4rem)] font-bold text-white">
            {line2}
          </span>
          <span class="whitespace-nowrap text-[length:clamp(1rem,6.3cqw,4rem)] font-semibold text-brand">
            {line3}
          </span>
          <span class="text-[length:clamp(1.25rem,8.55cqw,5.5rem)] font-bold text-brand">
            {line4}
          </span>
        </h1>
      </div>
    </div>
  </Container>
</section>
