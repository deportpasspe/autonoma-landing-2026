---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeView from "../views/HomeView.astro";
import { getPage, getSettings } from "../lib/cms";
import { buildPageMeta } from "../lib/seo/meta";
import type { HeroSection } from "../lib/cms/types";

const page = await getPage("home");
const settings = await getSettings();

if (!page) {
  throw new Error("Home page fixture missing");
}

const meta = buildPageMeta({
  title: page.title,
  description: page.description,
  path: "/",
});

const hero = page.sections.find((section): section is HeroSection => section._type === "hero");
const lcpImage = hero?.imageSrc;
---

<BaseLayout title={meta.title} description={meta.description} canonical={meta.canonical} lcpImage={lcpImage}>
  <HomeView page={page} settings={settings} />
</BaseLayout>
