---
interface Props {
  id: string;
  name: string;
  rows?: number;
  placeholder?: string;
  required?: boolean;
  describedBy?: string;
  class?: string;
}

const {
  id,
  name,
  rows = 4,
  placeholder,
  required = false,
  describedBy,
  class: className = "",
} = Astro.props;

const textareaClass =
  "w-full rounded-lg border border-border bg-white px-4 py-2.5 text-body text-black placeholder:text-text-muted focus-visible:border-brand focus-visible:outline-none";
---

<textarea
  id={id}
  name={name}
  rows={rows}
  placeholder={placeholder}
  required={required}
  aria-describedby={describedBy}
  class:list={[textareaClass, className]}
></textarea>
