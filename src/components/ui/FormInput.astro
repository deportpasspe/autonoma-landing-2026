---
interface Props {
  id: string;
  name: string;
  type?: "text" | "email" | "password" | "tel" | "url" | "search" | "number";
  placeholder?: string;
  required?: boolean;
  autocomplete?: string;
  inputmode?: "none" | "text" | "tel" | "url" | "email" | "numeric" | "decimal" | "search";
  describedBy?: string;
  class?: string;
}

const {
  id,
  name,
  type = "text",
  placeholder,
  required = false,
  autocomplete,
  inputmode,
  describedBy,
  class: className = "",
} = Astro.props;

const inputClass =
  "min-h-11 w-full rounded-lg border border-border bg-white px-4 py-2.5 text-body text-black placeholder:text-text-muted focus-visible:border-brand focus-visible:outline-none";
---

<input
  id={id}
  name={name}
  type={type}
  placeholder={placeholder}
  required={required}
  autocomplete={autocomplete}
  inputmode={inputmode}
  aria-describedby={describedBy}
  class:list={[inputClass, className]}
/>
