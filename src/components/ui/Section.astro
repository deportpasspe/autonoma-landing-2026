---
type Tone =
  | "default"
  | "brand"
  | "lavender"
  | "yellow"
  | "sky"
  | "white"
  | "none";

interface Props {
  id?: string;
  tone?: Tone;
  class?: string;
  ariaLabelledby?: string;
  /** Reserved for callers; rail inset lives on Container, not the section shell. */
  formRail?: boolean;
}

const {
  id,
  tone = "default",
  class: className = "",
  ariaLabelledby,
} = Astro.props as Props;

const tones: Record<Tone, string> = {
  default: "bg-white text-negro",
  brand: "bg-brand text-white",
  lavender: "bg-lavender text-negro",
  yellow: "bg-yellow text-negro",
  sky: "bg-sky text-negro",
  white: "bg-white text-negro",
  none: "",
};

const coloredTones = new Set<Tone>(["brand", "lavender", "yellow", "sky"]);
const withNoise = coloredTones.has(tone);
---

<section
  id={id}
  class:list={[
    "py-[var(--space-section-y)]",
    tones[tone],
    withNoise && "section-noise relative overflow-hidden",
    className,
  ]}
  aria-labelledby={ariaLabelledby}
>
  <slot />
</section>
