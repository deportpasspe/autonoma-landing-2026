---
import Button from "../ui/Button.astro";
import FormInput from "../ui/FormInput.astro";
import FormSelect from "../ui/FormSelect.astro";

interface Props {
  formTitle: string;
  formSubtitle?: string;
  formSubmitLabel: string;
  modalities: string[];
  campuses: string[];
  careers: string[];
  class?: string;
}

const {
  formTitle,
  formSubtitle = "Escoge la modalidad que prefieras",
  formSubmitLabel,
  modalities,
  campuses,
  careers,
  class: className = "",
} = Astro.props as Props;

const fieldClass =
  "h-11 !min-h-11 w-full appearance-none rounded-lg border border-[#b3b3b3] bg-white px-3 py-0 pr-9 text-[14px] text-negro transition-[border-color,box-shadow,background-color] duration-200 placeholder:text-[#939393] hover:border-brand/60 focus-visible:border-brand focus-visible:shadow-[0_0_0_3px_rgba(255,102,0,0.15)] focus-visible:outline-none";

const inputFieldClass =
  "h-11 !min-h-11 w-full rounded-md border border-[#b3b3b3] bg-white px-3 py-0 text-[14px] text-negro transition-[border-color,box-shadow,background-color] duration-200 placeholder:text-[#939393] hover:border-brand/60 focus-visible:border-brand focus-visible:shadow-[0_0_0_3px_rgba(255,102,0,0.15)] focus-visible:outline-none";
---

<form
  class:list={[
    "flex w-full max-w-[var(--form-card)] flex-col gap-4 overflow-hidden rounded-2xl bg-white text-negro shadow-[0_20px_60px_rgba(0,0,0,0.18)]",
    className,
  ]}
  method="post"
  action="#inicio"
  aria-labelledby="registro-title"
  data-registration-form
>
  <div class="px-6 pt-6 text-center">
    <h2 id="registro-title" class="text-[1.5rem] font-bold leading-normal text-negro">
      {formTitle}
    </h2>
    <p class="mt-0 text-[1.125rem] font-normal leading-normal text-brand">{formSubtitle}</p>
  </div>

  <fieldset class="flex flex-wrap items-center gap-x-2.5 gap-y-2 px-6 pt-2">
    <legend class="sr-only">Modalidad</legend>
    {
      modalities.map((modality, index) => (
        <label class="inline-flex cursor-pointer items-center gap-2 text-[14px] font-medium text-negro transition-colors duration-200 hover:text-brand">
          <input
            type="radio"
            name="modalidad"
            value={modality}
            required
            checked={index === 1}
            class="size-[18px] shrink-0 accent-brand transition-transform duration-150 checked:scale-110"
          />
          {modality}
        </label>
      ))
    }
  </fieldset>

  <div class="flex flex-col gap-4 px-4 pb-6">
    <div class="flex flex-col gap-3">
      <div class="relative">
        <label for="reg-campus" class="sr-only">Escoge tu campus</label>
        <FormSelect id="reg-campus" name="campus" required class={fieldClass}>
          <option value="">Escoge tu campus</option>
          {campuses.map((campus) => <option value={campus}>{campus}</option>)}
        </FormSelect>
        <svg
          class="pointer-events-none absolute right-3 top-1/2 h-[7px] w-3 -translate-y-1/2 text-brand"
          viewBox="0 0 12 7"
          fill="none"
          aria-hidden="true"
        >
          <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          ></path>
        </svg>
      </div>

      <div class="relative">
        <label for="reg-carrera" class="sr-only">Escoge tu carrera</label>
        <FormSelect id="reg-carrera" name="carrera" required class={fieldClass}>
          <option value="">Escoge tu carrera</option>
          {careers.map((career) => <option value={career}>{career}</option>)}
        </FormSelect>
        <svg
          class="pointer-events-none absolute right-3 top-1/2 h-[7px] w-3 -translate-y-1/2 text-brand"
          viewBox="0 0 12 7"
          fill="none"
          aria-hidden="true"
        >
          <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          ></path>
        </svg>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label for="reg-nombres" class="sr-only">Nombres</label>
          <FormInput
            id="reg-nombres"
            name="nombres"
            type="text"
            required
            autocomplete="given-name"
            placeholder="Nombres*"
            class={inputFieldClass}
          />
        </div>
        <div>
          <label for="reg-apellidos" class="sr-only">Apellidos</label>
          <FormInput
            id="reg-apellidos"
            name="apellidos"
            type="text"
            required
            autocomplete="family-name"
            placeholder="Apellidos*"
            class={inputFieldClass}
          />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div>
          <label for="reg-celular" class="sr-only">Celular</label>
          <FormInput
            id="reg-celular"
            name="celular"
            type="tel"
            required
            autocomplete="tel"
            placeholder="Celular"
            class={inputFieldClass}
          />
        </div>
        <div>
          <label for="reg-correo" class="sr-only">Correo electrónico</label>
          <FormInput
            id="reg-correo"
            name="correo"
            type="email"
            required
            autocomplete="email"
            placeholder="Correo electrónico"
            class={inputFieldClass}
          />
        </div>
      </div>
    </div>

    <p class="text-[14px] font-medium leading-normal text-brand">(*) Campos obligatorios</p>

    <label class="group flex cursor-pointer items-start gap-2 text-[12px] leading-normal text-negro">
      <input
        type="checkbox"
        name="privacidad"
        required
        class="mt-0.5 size-[18px] shrink-0 rounded border border-[#b3b3b3] accent-brand transition-transform duration-150 checked:scale-105"
      />
      <span>
        Declaro expresamente haber leído y aceptado las{" "}
        <a
          href="#"
          class="font-bold underline decoration-brand/40 underline-offset-2 transition-colors duration-200 hover:text-brand hover:decoration-brand"
        >
          Políticas de Privacidad
        </a>
      </span>
    </label>

    <Button
      type="submit"
      variant="brand"
      class="!h-11 !min-h-11 !rounded !px-4 !py-2.5 !text-[16px] !normal-case !tracking-normal w-full transition-transform duration-200 hover:brightness-105 active:scale-[0.98]"
    >
      {formSubmitLabel}
    </Button>
  </div>
</form>
