---
import Button from "../ui/Button.astro";
import FormInput from "../ui/FormInput.astro";
import FormSelect from "../ui/FormSelect.astro";

interface Props {
  formTitle: string;
  formSubtitle?: string;
  formSubmitLabel: string;
  modalities: string[];
  campuses: string[];
  careers: string[];
  class?: string;
}

const {
  formTitle,
  formSubtitle = "Escoge la modalidad que prefieras",
  formSubmitLabel,
  modalities,
  campuses,
  careers,
  class: className = "",
} = Astro.props as Props;

const fieldClass =
  "h-10 !min-h-10 w-full appearance-none rounded-lg border border-[#b3b3b3] bg-white px-3 py-0 pr-9 text-base text-negro transition-[border-color,box-shadow,background-color] duration-200 placeholder:text-[#939393] hover:border-brand/60 focus-visible:border-brand focus-visible:shadow-[0_0_0_3px_rgba(255,102,0,0.15)] focus-visible:outline-none md:text-[14px]";

const inputFieldClass =
  "h-10 !min-h-10 w-full rounded-md border border-[#b3b3b3] bg-white px-3 py-0 text-base text-negro transition-[border-color,box-shadow,background-color] duration-200 placeholder:text-[#939393] hover:border-brand/60 focus-visible:border-brand focus-visible:shadow-[0_0_0_3px_rgba(255,102,0,0.15)] focus-visible:outline-none md:text-[14px]";
---

<form
  class:list={[
    "flex w-full flex-col gap-2.5 overflow-hidden rounded-2xl bg-white text-negro shadow-[0_20px_60px_rgba(0,0,0,0.18)] sm:gap-3",
    className,
  ]}
  method="post"
  action="#inicio"
  aria-labelledby="registro-title"
  data-registration-form
>
  <div class="px-4 pb-1 pt-5 text-center sm:px-6 sm:pb-1.5 sm:pt-5">
    <h2 id="registro-title" class="text-[clamp(1.25rem,4vw,1.5rem)] font-bold leading-snug text-negro">
      {formTitle}
    </h2>
    <p class="mt-0.5 text-base font-normal leading-snug text-brand sm:text-[clamp(1rem,3.2vw,1.125rem)]">{formSubtitle}</p>
  </div>

  <fieldset class="grid grid-cols-3 gap-2 px-4 sm:px-6 lg:flex lg:flex-wrap lg:items-center lg:gap-x-3 lg:gap-y-1.5 lg:px-6">
    <legend class="sr-only">Modalidad</legend>
    {
      modalities.map((modality) => (
        <label
          class:list={[
            "group relative flex min-h-10 cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border px-1.5 py-2 text-center transition-[border-color,background-color,color,box-shadow] duration-200",
            "border-[#d4d4d4] bg-[#fafafa] text-negro",
            "hover:border-brand/50 hover:bg-brand/5",
            "has-[:checked]:border-brand has-[:checked]:bg-brand/10 has-[:checked]:text-brand has-[:checked]:shadow-[0_0_0_1px_rgba(255,102,0,0.35)]",
            "has-[:focus-visible]:border-brand has-[:focus-visible]:shadow-[0_0_0_3px_rgba(255,102,0,0.15)]",
            "lg:min-h-9 lg:flex-row lg:justify-start lg:gap-2 lg:rounded-none lg:border-0 lg:bg-transparent lg:px-0 lg:py-0 lg:text-left lg:shadow-none",
            "lg:hover:border-transparent lg:hover:bg-transparent",
            "lg:has-[:checked]:border-0 lg:has-[:checked]:bg-transparent lg:has-[:checked]:text-negro lg:has-[:checked]:shadow-none",
            "lg:has-[:focus-visible]:shadow-none",
          ]}
        >
          <input
            type="radio"
            name="modalidad"
            value={modality}
            required
            class="modality-radio size-[18px] shrink-0 appearance-none rounded-full border-2 border-[#cfcfcf] bg-white transition-[border-color,box-shadow,background-color] duration-150 checked:border-brand checked:bg-brand checked:shadow-[inset_0_0_0_3px_#fff] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand/40 focus-visible:ring-offset-1"
          />
          <span class="text-small font-semibold leading-snug lg:font-medium">
            {modality}
          </span>
        </label>
      ))
    }
  </fieldset>

  <div class="flex flex-col gap-3 px-4 pb-4 sm:px-6 sm:pb-5">
    <div class="flex flex-col gap-2.5">
      <div class="relative">
        <label for="reg-campus" class="sr-only">Escoge tu campus</label>
        <FormSelect id="reg-campus" name="campus" required class={fieldClass}>
          <option value="">Escoge tu campus</option>
          {campuses.map((campus) => <option value={campus}>{campus}</option>)}
        </FormSelect>
        <svg
          class="pointer-events-none absolute right-3 top-1/2 h-[7px] w-3 -translate-y-1/2 text-brand"
          viewBox="0 0 12 7"
          fill="none"
          aria-hidden="true"
        >
          <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          ></path>
        </svg>
      </div>

      <div class="relative">
        <label for="reg-carrera" class="sr-only">Escoge tu carrera</label>
        <FormSelect id="reg-carrera" name="carrera" required class={fieldClass}>
          <option value="">Escoge tu carrera</option>
          {careers.map((career) => <option value={career}>{career}</option>)}
        </FormSelect>
        <svg
          class="pointer-events-none absolute right-3 top-1/2 h-[7px] w-3 -translate-y-1/2 text-brand"
          viewBox="0 0 12 7"
          fill="none"
          aria-hidden="true"
        >
          <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          ></path>
        </svg>
      </div>

      {/* Mobile-first: one field per row; two columns from md+ */}
      <div class="flex flex-col gap-2.5 md:grid md:grid-cols-2 md:gap-2">
        <div class="w-full">
          <label for="reg-nombres" class="sr-only">Nombres</label>
          <FormInput
            id="reg-nombres"
            name="nombres"
            type="text"
            required
            autocomplete="given-name"
            placeholder="Nombres*"
            class={inputFieldClass}
          />
        </div>
        <div class="w-full">
          <label for="reg-apellidos" class="sr-only">Apellidos</label>
          <FormInput
            id="reg-apellidos"
            name="apellidos"
            type="text"
            required
            autocomplete="family-name"
            placeholder="Apellidos*"
            class={inputFieldClass}
          />
        </div>
      </div>

      <div class="flex flex-col gap-2.5 md:grid md:grid-cols-2 md:gap-2">
        <div class="w-full">
          <label for="reg-celular" class="sr-only">Celular</label>
          <FormInput
            id="reg-celular"
            name="celular"
            type="tel"
            required
            autocomplete="tel"
            inputmode="tel"
            placeholder="Celular"
            class={inputFieldClass}
          />
        </div>
        <div class="w-full">
          <label for="reg-correo" class="sr-only">Correo electrónico</label>
          <FormInput
            id="reg-correo"
            name="correo"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="Correo electrónico"
            class={inputFieldClass}
          />
        </div>
      </div>
    </div>

    <p class="text-small font-medium leading-snug text-brand">(*) Campos obligatorios</p>

    <label class="group flex cursor-pointer items-start gap-2 text-[12px] leading-snug text-negro">
      <input
        type="checkbox"
        name="privacidad"
        required
        class="mt-0.5 size-[18px] shrink-0 rounded border border-[#b3b3b3] accent-brand transition-transform duration-150 checked:scale-105"
      />
      <span>
        Declaro expresamente haber leído y aceptado las{" "}
        <a
          href="#"
          class="font-bold underline decoration-brand/40 underline-offset-2 transition-colors duration-200 hover:text-brand hover:decoration-brand"
        >
          Políticas de Privacidad
        </a>
      </span>
    </label>

    <Button
      type="submit"
      variant="brand"
      class="!h-10 !min-h-10 !rounded !px-4 !py-2 !text-[16px] !normal-case !tracking-normal w-full transition-transform duration-200 hover:brightness-105 active:scale-[0.98]"
    >
      {formSubmitLabel}
    </Button>
  </div>
</form>
