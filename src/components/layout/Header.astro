---
import type { SiteSettings } from "../../lib/cms/types";
import Container from "../ui/Container.astro";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props as Props;
---

<header class="absolute inset-x-0 top-0 z-50">
  <Container>
    <div class="flex min-h-[95px] items-center justify-between gap-6 py-3 lg:gap-8">
      <a href="/" class="flex shrink-0 items-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
        <img src={settings.logoSrc} alt={settings.logoAlt} width="250" height="71" class="h-14 w-auto md:h-[71px]" />
      </a>

      <nav
        class="hidden min-w-0 flex-1 items-center justify-end gap-1 lg:flex xl:gap-2 2xl:gap-4"
        aria-label="Navegación principal"
      >
        {
          settings.navLinks.map((link) => (
            <a
              href={link.href}
              class="inline-flex min-h-11 min-w-[5.5rem] items-center justify-center px-2.5 py-2.5 text-center text-[clamp(1rem,0.45vw+0.75rem,1.25rem)] font-medium leading-normal text-white transition-opacity duration-200 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white xl:min-w-[6.5rem] xl:px-3"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <button
        type="button"
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[var(--radius-button)] border border-white/40 bg-white/10 p-2 text-white lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
        data-mobile-nav-toggle
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </Container>

  <nav id="mobile-nav" class="hidden border-t border-white/20 bg-brand-accessible lg:hidden" aria-label="Navegación móvil" data-mobile-nav>
    <Container>
      <ul class="flex flex-col gap-1 py-4">
        {
          settings.navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex min-h-12 items-center rounded-[var(--radius-button)] px-3 text-[1.125rem] font-medium text-white hover:bg-white/10"
                data-mobile-nav-link
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-mobile-nav-toggle]");
  const nav = document.querySelector("[data-mobile-nav]");
  const links = document.querySelectorAll("[data-mobile-nav-link]");

  if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      nav.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    links.forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
