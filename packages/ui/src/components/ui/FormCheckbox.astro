---
interface Props {
  id: string;
  name: string;
  label: string;
  required?: boolean;
  describedBy?: string;
  class?: string;
}

const { id, name, label, required = false, describedBy, class: className = "" } = Astro.props;
---

<label class:list={["flex min-h-11 cursor-pointer items-start gap-3", className]}>
  <input
    type="checkbox"
    id={id}
    name={name}
    required={required}
    aria-describedby={describedBy}
    class="mt-1 size-4 shrink-0 rounded border-border text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
  />
  <span class="text-body text-black">{label}</span>
</label>
