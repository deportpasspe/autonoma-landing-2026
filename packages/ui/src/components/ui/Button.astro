---
type Variant = "primary" | "brand" | "ghost" | "secondary";

interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: Variant;
  class?: string;
  ariaLabel?: string;
  disabled?: boolean;
}

const {
  href,
  type = "button",
  variant = "brand",
  class: className = "",
  ariaLabel,
  disabled = false,
} = Astro.props;

const base =
  "inline-flex min-h-11 items-center justify-center rounded-[var(--radius-button)] px-6 py-3 text-small font-bold uppercase tracking-wide transition-colors duration-[var(--duration-fast)] focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50";

const variants: Record<Variant, string> = {
  primary: "bg-white text-brand hover:bg-white/90 focus-visible:outline-white",
  brand: "bg-brand text-white hover:bg-brand-dark focus-visible:outline-brand",
  secondary: "border-2 border-brand bg-transparent text-brand hover:bg-brand hover:text-white focus-visible:outline-brand",
  ghost: "bg-transparent text-negro hover:bg-negro/5 focus-visible:outline-negro",
};

const classes = [base, variants[variant], className].filter(Boolean).join(" ");
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} disabled={disabled}>
      <slot />
    </button>
  )
}
