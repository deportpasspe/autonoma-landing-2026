{
  "name": "autonoma-landings",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:principal": "npm run dev -w apps/landing-principal",
    "dev:arequipa": "npm run dev -w apps/landing-arequipa",
    "build": "npm run build -w apps/landing-arequipa",
    "build:principal": "npm run build -w apps/landing-principal",
    "build:arequipa": "npm run build -w apps/landing-arequipa",
    "check:principal": "npm run check -w apps/landing-principal",
    "check:arequipa": "npm run check -w apps/landing-arequipa",
    "export:principal": "npm run export:static -w apps/landing-principal",
    "export:arequipa": "npm run export:static -w apps/landing-arequipa"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
